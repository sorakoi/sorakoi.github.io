---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import ImageWrapper from "./misc/ImageWrapper.astro";

const { banner } = siteConfig;
const images = banner.images?.length ? banner.images : [{ src: banner.src }];
const creditUrl = banner.credit.url?.trim();
const Credit = creditUrl ? "a" : "span";
---

<div id="banner-wrapper" class="relative z-10 w-full overflow-hidden" data-interval={banner.interval ?? 8}>
    {images.map((image, index) => {
        const Container = index === 0 ? "div" : "template";
        return (
            <div class="banner-slide" aria-hidden="true" data-current={index === 0 ? "" : undefined} data-credit={image.credit || banner.credit.text}>
                <Container class="h-full">
                    <ImageWrapper src={image.src} position={banner.position} class="h-full w-full" />
                </Container>
            </div>
        );
    })}
    <div class="banner-fade absolute inset-x-0 bottom-0 z-10 h-[30%] pointer-events-none"></div>
    {banner.credit.enable && (
        <Credit href={creditUrl || undefined} target={creditUrl ? "_blank" : undefined} rel={creditUrl ? "noopener" : undefined}
            class:list={["group transition-all absolute z-10 flex justify-center items-center rounded-full px-3 bottom-4 right-4 bg-black/60 h-9",
                { "hover:pr-9 hover:bg-black/70 active:bg-black/80": creditUrl }]}>
            <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" />
            <span class="text-white/75 text-xs" data-banner-credit>{images[0].credit || banner.credit.text}</span>
            {creditUrl && <Icon class="transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0 group-hover:opacity-100" name="fa6-solid:arrow-up-right-from-square" />}
        </Credit>
    )}
</div>

<style>
    .banner-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        pointer-events: none;
        /* Keep the outgoing image behind the incoming one until the fade completes. */
        transition: opacity 0s 1.2s;
    }
    .banner-slide[data-current] {
        z-index: 1;
        opacity: 1;
        transition: opacity 1.2s ease;
    }
    .banner-fade {
        background: linear-gradient(to bottom, transparent, var(--page-bg));
    }
    @media (prefers-reduced-motion: reduce) {
        .banner-slide, .banner-slide[data-current] { transition: none; }
    }
</style>

<script>
    // The banner is outside Swup's replacement containers and persists across visits.
    const banner = document.getElementById("banner-wrapper");
    if (banner) {
        const slides = Array.from(banner.querySelectorAll<HTMLElement>(".banner-slide"));
        const credit = banner.querySelector("[data-banner-credit]");
        const interval = Number(banner.dataset.interval) * 1000;
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        let current = 0;
        let timer = 0;

        function show(index: number) {
            slides[current].removeAttribute("data-current");
            slides[index].setAttribute("data-current", "");
            if (credit) credit.textContent = slides[index].dataset.credit ?? "";
            current = index;
        }

        function prepare(index: number) {
            const slide = slides[index];
            const template = slide.querySelector("template");
            if (template) {
                const img = template.content.querySelector("img");
                if (img) img.loading = "eager";
                template.replaceWith(template.content);
            }
            const image = slide.querySelector("img")!;
            const pending = window.setTimeout(async () => {
                // Keep the current image visible while a slow successor finishes loading.
                const ready = await image.decode().then(() => true, () => false);
                if (pending !== timer) return;
                if (ready) show(index);
                prepare((index + 1) % slides.length);
            }, interval);
            timer = pending;
        }

        function syncMotion() {
            clearTimeout(timer);
            timer = 0;
            if (motion.matches) show(0);
            else if (slides.length > 1) prepare((current + 1) % slides.length);
        }
        motion.addEventListener("change", syncMotion);
        syncMotion();
    }
</script>
