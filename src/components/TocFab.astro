---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import TOC from "./widget/TOC.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
// 收录一级到三级标题：不少文章直接用 ### 写小标题，只留 h1/h2 会导致索引为空
const items = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

{
	items.length > 0 && (
		<floating-toc class="toc-fab" data-toc-fab role="complementary" aria-label="文章目录">
			<button
				type="button"
				id="toc-fab-btn"
				aria-label="打开文章目录"
				aria-expanded="false"
				class="btn-regular rounded-full h-11 w-11 flex items-center justify-center shadow-lg active:scale-90 transition"
			>
				<Icon name="material-symbols:list-rounded" class="text-[1.35rem]"></Icon>
			</button>

			<div id="toc-fab-panel" class="toc-fab-panel card-base">
				<div class="flex items-center justify-between px-3 pt-3 pb-1">
					<span class="text-sm font-bold text-neutral-900 dark:text-neutral-100 transition">目录</span>
					<button
						type="button"
						id="toc-fab-close"
						aria-label="关闭目录"
						class="btn-plain rounded-lg h-7 w-7 flex items-center justify-center active:scale-90"
					>
						<Icon name="material-symbols:close-rounded" class="text-[1.1rem]"></Icon>
					</button>
				</div>
				<div class="px-1 pb-3 max-h-[60vh] overflow-y-auto">
					<TOC headings={items} class="text-sm"></TOC>
				</div>
			</div>
		</floating-toc>
	)
}

<style>
	.toc-fab {
		position: fixed;
		right: 1.25rem;
		bottom: 4rem;
		z-index: 45;
	}

	.toc-fab-panel {
		position: absolute;
		right: 0;
		bottom: calc(100% + 0.6rem);
		width: 17rem;
		box-shadow:
			0 12px 32px rgba(0, 0, 0, 0.14),
			0 2px 8px rgba(0, 0, 0, 0.08);
		opacity: 0;
		transform: translateY(0.5rem) scale(0.97);
		transform-origin: bottom right;
		pointer-events: none;
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.toc-fab.is-open .toc-fab-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}
</style>

<script>
	class FloatingTOC extends HTMLElement {
		controller: AbortController | null = null;

		connectedCallback() {
			const fab = this;
			// 正文带 transform，浮层需要移到 body 才能相对视口定位。
			// 移动会再次触发 connectedCallback，由重连的回调绑定监听。
			if (fab.parentElement !== document.body) {
				document.body.appendChild(fab);
				return;
			}
			if (this.controller) return;
			const btn = fab.querySelector<HTMLButtonElement>("#toc-fab-btn");
			const close = fab.querySelector("#toc-fab-close");
			if (!btn) return;
			const controller = new AbortController();
			this.controller = controller;
			const { signal } = controller;
			document.addEventListener("astro:before-swap", () => fab.remove(), { signal });

			const toggle = (open: boolean) => {
				fab.classList.toggle("is-open", open);
				btn.setAttribute("aria-expanded", String(open));
			};

			btn.addEventListener("click", () => {
				toggle(!fab.classList.contains("is-open"));
			}, { signal });

			close?.addEventListener("click", () => toggle(false), { signal });

			document.addEventListener("click", (e) => {
				if (!fab.classList.contains("is-open")) return;
				const t = e.target;
				if (t instanceof Node && !fab.contains(t)) toggle(false);
			}, { signal });

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") toggle(false);
			}, { signal });

			// 点击目录项后收起
			fab.querySelectorAll("table-of-contents a").forEach((a) => {
				a.addEventListener("click", () => toggle(false), { signal });
			});
		}

		disconnectedCallback() {
			this.controller?.abort();
			this.controller = null;
		}
	}

	if (!customElements.get("floating-toc")) {
		customElements.define("floating-toc", FloatingTOC);
	}
</script>
