---
import type { MarkdownHeading } from "astro";
import TOC from "./TOC.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const items = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<div id="toc-card-wrapper" class:list={[items.length ? "transition-swup-toc" : "hidden"]}>
	{items.length > 0 && (
		<div class="min-h-0 overflow-hidden">
			<WidgetLayout name="目录" id="toc-card" class="block">
				<div class="px-1 pb-1 max-h-[45vh] overflow-y-auto">
					<TOC headings={items} class="text-sm" />
				</div>
			</WidgetLayout>
		</div>
	)}
</div>
