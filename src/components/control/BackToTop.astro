---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <button type="button" id="back-to-top-btn" aria-label="回到顶部" class="floating-control back-to-top-btn hide" onclick="backToTop()">
        <Icon name="material-symbols:keyboard-arrow-up-rounded" class="text-[2.25rem]" />
    </button>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    position: fixed
    right: calc(var(--floating-control-center) - 1.875rem)
    bottom: 10rem
    opacity: 1
    cursor: pointer
    pointer-events: auto
    &.hide
        transform: scale(0.9)
        visibility: hidden
        opacity: 0
        pointer-events: none

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
